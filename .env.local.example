# Where agent replies come from: mock | vertex | anthropic | openai
# Unset = anthropic if ANTHROPIC_API_KEY is present, otherwise mock.
AGENT_PROVIDER=mock

# Public origin used for share cards and the sitemap once deployed.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Abuse/cost guards (all optional; sensible defaults in lib/rateLimit.ts) ---
# Chat turns per IP: 20/min and 300/day by default.
# AGENT_RATE_PER_MINUTE=20
# AGENT_RATE_PER_DAY=300
# Real phone calls: 3/hour per IP and 10/day globally by default.
# VOICE_RATE_PER_HOUR=3
# VOICE_RATE_GLOBAL_PER_DAY=10
# Real SMS threads: 5/hour per IP and 30/day globally by default.
# SMS_RATE_PER_HOUR=5
# SMS_RATE_GLOBAL_PER_DAY=30
# REQUIRED for real phone calls AND real SMS: without this PIN both real
# channels are fully disabled. Pick any short code and type it into the
# demo when asked.
# VOICE_DEMO_PIN=2468

# --- Business config database (Supabase Postgres) ---
# Without this set, agents still run fine — getBusinessConfig() falls back
# to the two hardcoded configs in src/lib/agents/configs/*.ts. Set it to
# unlock the /admin business-config screen and let onboarding a new client
# be a form, not a code change. See docs/tech-stack-roadmap.md and
# docs/agent-templates.md.
# 1. Create a project at https://supabase.com (free tier is plenty).
# 2. Project Settings -> Database -> Connection string -> copy the
#    "Transaction pooler" string (NOT "Direct connection" — the app runs
#    serverless-style and the pooler avoids exhausting Supabase's connection
#    limit). Looks like:
#    postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
#
# drizzle-kit (npm run db:generate / db:migrate) needs a non-pooled
# connection for schema migrations — use the "Session pooler" or "Direct
# connection" string here. Falls back to DATABASE_URL if unset.
# DATABASE_MIGRATION_URL=postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres
#
# Then: npm run db:generate && npm run db:migrate && npm run db:seed

# --- Admin screen (/admin — edit business configs without code) ---
# Unset = /admin is fully disabled, same pattern as VOICE_DEMO_PIN above.
# ADMIN_PIN=1357

# --- Client dashboard login (Supabase Auth) ---
# Required for /dashboard — it's login-only, no more public ?business=<id>
# link. Reuses the same Supabase project as DATABASE_URL above.
# 1. Supabase dashboard -> Project Settings -> API.
# 2. NEXT_PUBLIC_SUPABASE_URL = "Project URL".
# 3. NEXT_PUBLIC_SUPABASE_ANON_KEY = the "anon public" key (safe to expose
#    to the browser — Postgres row-level access is still whatever you've
#    configured; this app enforces access via the businessId lookup, not RLS).
# 4. SUPABASE_SERVICE_ROLE_KEY = the "service_role" secret key. Server-only
#    — never NEXT_PUBLIC_. Used only by scripts/seed-auth-users.ts (via
#    npm run db:seed) to create the two demo accounts through the Admin API.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Provider: anthropic (real Claude via Anthropic API key) ---
# Get a key at https://console.claude.com and add prepaid credits (~$5 min).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Provider: vertex (real Claude via Google Vertex AI, free trial credits) ---
# 1. Create a Google Cloud project; new accounts get ~$300 free trial credit.
# 2. Enable the Claude models in Vertex AI Model Garden.
# 3. Auth locally: gcloud auth application-default login
# 4. Fill these in and set AGENT_PROVIDER=vertex above:
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=global

# --- Provider: openai (GPT instead of Claude, e.g. for cost/vendor comparisons) ---
# Get a key at https://platform.openai.com/api-keys and set AGENT_PROVIDER=openai above.
# Default model is gpt-4.1 — override per-agent via a BusinessConfig's `model` field.
# OPENAI_API_KEY=sk-your-key-here

# --- Real phone calls (speed-to-lead "Zadzwoń do mnie teraz" button) ---
# Also requires VOICE_DEMO_PIN above — the button won't place calls without it.
# 1. Sign up at https://www.twilio.com/try-twilio (free trial credit).
# 2. Verify your own phone number (trial accounts can only call verified numbers).
# 3. Buy a Twilio phone number with international calling enabled for Poland
#    (Console -> Phone Numbers -> Buy a number; then Voice -> Settings -> Geo
#    Permissions -> enable Poland).
# 4. Get your Account SID + Auth Token from the Twilio Console dashboard.
# 5. Run ngrok (tunnels localhost:3000 to a public HTTPS URL Twilio can reach):
#      ngrok http 3000
#    Copy the "https://xxxx.ngrok-free.app" URL it prints into PUBLIC_BASE_URL.
#
# --- Real two-way SMS (speed-to-lead "Napisz do mnie" button) ---
# Uses the same Twilio account + VOICE_DEMO_PIN gate as real calls. Extra
# one-time setup on top of the call config above:
# 1. Twilio Console -> your phone number -> Messaging Configuration ->
#    "A message comes in" -> Webhook = {PUBLIC_BASE_URL}/api/sms/inbound,
#    HTTP POST. (If the ngrok URL changes, update this webhook too.)
# 2. Messaging -> Settings -> Geo Permissions -> enable Poland for SMS
#    (separate from the Voice geo permission).
# 3. Trial accounts can only text VERIFIED numbers, and every message is
#    prefixed with "Sent from your Twilio trial account".
# TWILIO_ACCOUNT_SID=AC1d68b4580efec38d866bdf8b0266407d
# TWILIO_AUTH_TOKEN=5bd5e08aec3c0d36800c87f909fbf48a
# TWILIO_PHONE_NUMBER=+13506004824
# PUBLIC_BASE_URL=https://sureness-squabble-distant.ngrok-free.dev/
